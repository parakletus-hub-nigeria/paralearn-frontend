# Backend API URLs
K12_BACKEND_URL=http://localhost:8000
UNI_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_CBT_API_URL=http://localhost:4000

# Google Gemini AI Configuration (Used for CBT Question Generator & AI Essay Grader)
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# CBT examiner sign-in (server only)
# Signs the CBT session cookie. Required in production; use a long random value.
CBT_SESSION_SECRET=
# Shared with the Nest CBT service (paralearn-cbt-backend). Server-to-server calls
# from /api/cbt send it as x-cbt-service-key; without it imports and rosters fail.
CBT_SERVICE_SECRET=
# Server-side URL of the Nest CBT service (defaults to NEXT_PUBLIC_CBT_API_URL)
CBT_BACKEND_URL=http://localhost:4000
